{
  "name": "neuro-assistant",
  "version": "1.0.0",
  "description": "Нейропомощник - веб-приложение для повседневных задач с использованием Google Gemini API",
  "main": "index.html",
  "scripts": {
    "dev": "live-server --port=3001 --open=/index.html",
    "build": "echo 'Build completed - files are ready for deployment'",
    "serve": "http-server . -p 8080 -o",
    "start": "npm run dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "keywords": [
    "ai",
    "assistant",
    "gemini",
    "web-app",
    "productivity"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@vitest/ui": "^4.1.4",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.2",
    "live-server": "^1.2.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
